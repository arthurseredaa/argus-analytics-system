{
  "name": "funnels-analytics-events",
  "main": "src/index.ts",
  // Capped by the newest date the workerd bundled with @cloudflare/vitest-plugin accepts.
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  // TEST_ROUTES is "off" here (R-12: /__test/* answers 404). The CI deploy turns it on for the
  // demo (decision 1 of the stage 1 plan); a production deploy drops that flag.
  "vars": {
    "GIT_SHA": "dev",
    "TEST_ROUTES": "off",
    // Alert thresholds (stage 6 plan, decision 8). The values are the rows of docs/requirements/nfr.md,
    // "Set in stage 4"; tests/unit/wrangler-config.test.ts pins them. d1_events_size_bytes is the Paid
    // value; the Free plan uses 350000000. The alerts that fire on "any" have no threshold here.
    "ALERT_THRESHOLDS": {
      "freshness_lag_ms": 900000,
      "pending_oldest_file_ms": 3600000,
      "postbacks_min_requests": 5,
      "postbacks_window_ms": 900000,
      "d1_facts_size_bytes": 7000000000,
      "d1_events_size_bytes": 7000000000,
      "selection_p95_ms": 300,
      "worker_5xx_rate": 0.01,
      "d1_overload_errors_per_hour": 10,
    },
  },
  "d1_databases": [
    {
      // ADR 0003: facts in D1.
      "binding": "FACTS",
      "database_name": "facts",
      "database_id": "604b68c8-7e22-4284-b0e0-2f68d4d40fe0",
      "migrations_dir": "migrations/facts",
    },
    {
      // ADR 0005: MVP stand-in for BigQuery.
      "binding": "EVENTS",
      "database_name": "events",
      "database_id": "f1f91986-5816-4882-80d6-400bff6bd011",
      "migrations_dir": "migrations/events",
    },
  ],
  "queues": {
    // ADR 0005: event ingestion queue.
    "producers": [
      { "binding": "EVENTS_QUEUE", "queue": "events" },
      // Nothing sends to events-dlq and nothing consumes it. The binding exists only so the alert run
      // can read Queue.metrics().backlogCount for dlq_not_empty (stage 6 plan, decision 13).
      { "binding": "EVENTS_DLQ", "queue": "events-dlq" },
    ],
    "consumers": [
      {
        "queue": "events",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 10,
        "dead_letter_queue": "events-dlq",
      },
    ],
  },
  // ADR 0005, ADR 0006: the loader, every minute in the MVP. The second cron runs the alert evaluator
  // (src/ops/alerts.ts) every 5 minutes; src/index.ts tells the two apart by controller.cron.
  "triggers": { "crons": ["* * * * *", "*/5 * * * *"] },
  "r2_buckets": [
    // ADR 0005: raw event archive. The 30-day lifecycle rules for loaded/ and rejected/ are not in
    // this file; they are applied once to the account (decision 16 of the stage 5 plan).
    { "binding": "EVENTS_BUCKET", "bucket_name": "funnels-events" },
  ],
  "analytics_engine_datasets": [
    // docs/design/metrics-and-operations.md: metrics and reliability numbers.
    { "binding": "METRICS", "dataset": "funnels_metrics" },
  ],
}
