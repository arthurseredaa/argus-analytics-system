{
  "name": "funnels-analytics-events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "seed": "node scripts/seed.ts",
    "types": "wrangler types --strict-vars=false --env-file /dev/null",
    "typecheck": "wrangler types --strict-vars=false --env-file /dev/null && tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "oxlint --deny-warnings src tests scripts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint:docs": "node scripts/lint-docs.ts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm lint:docs && pnpm test",
    "prepare": "git config core.hooksPath .githooks",
    "migrate:local": "wrangler d1 migrations apply facts --local && wrangler d1 migrations apply events --local",
    "migrate:remote": "wrangler d1 migrations apply facts --remote && wrangler d1 migrations apply events --remote"
  },
  "dependencies": {
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@types/node": "24.19.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.3.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
