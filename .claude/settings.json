{
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-brief.sh",
            "timeout": 10,
            "statusMessage": "stage brief"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/oxc-after-edit.sh",
            "timeout": 30,
            "statusMessage": "oxfmt + oxlint on changed files"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm test -t *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:docs)",
      "Bash(pnpm fmt:check)",
      "Bash(pnpm state:check)"
    ]
  }
}
